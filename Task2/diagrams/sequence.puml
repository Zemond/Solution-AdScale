@startuml
title AdScale Task2 — RTB auction, события и деградация

hide footbox
autonumber

actor DSP
participant "API Gateway" as GW
participant "Bidding Service" as Bid
collections "Local immutable\nsnapshot" as Snapshot
queue "Bounded event\nspool" as Spool
queue "Kafka" as Kafka
participant "Finance / Stats /\nAnalytics consumers" as Consumers

DSP -> GW : POST /openrtb/2.x/bid\nOpenRTB JSON, id, tmax
activate GW
GW -> GW : TLS/auth, body limit,\npartner + global admission

alt auth/transport/rate policy rejected
  GW --> DSP : 401/403/429\n(or 204 by partner profile)
else request admitted
  GW -> Bid : request + trusted partner_id\n+ absolute deadline
  activate Bid
  Bid -> Bid : validate profile and\nremaining deadline

  alt invalid request
    Bid --> GW : INVALID
    GW --> DSP : 400 Bad Request
  else deadline too short or overload
    Bid --> GW : NO_BID(reason)
    GW --> DSP : 204 No Content
  else valid request
    Bid -> Snapshot : read current snapshot pointer
    Snapshot --> Bid : campaigns, targeting,\nbudget tokens, creatives
    Bid -> Bid : eligibility, caps,\nranking and pricing

    alt winner found before internal cutoff
      Bid -> Spool : enqueue decision telemetry\n(non-blocking, stable event_id)
      Bid --> GW : OpenRTB BidResponse
      deactivate Bid
      GW --> DSP : 200 BidResponse
      deactivate GW

      Spool -> Kafka : async produce + bounded retry
      Kafka -> Consumers : at-least-once delivery
      Consumers -> Consumers : inbox dedup +\ndomain update in one transaction
    else no eligible candidate
      Bid --> GW : NO_BID(no_candidate)
      GW --> DSP : 204 No Content
    else cutoff reached
      Bid -> Bid : cancel computation
      Bid --> GW : NO_BID(timeout)
      GW --> DSP : 204 No Content\nbefore external deadline
    end
  end
end

== Фактический показ или клик ==

actor "Browser / App" as User
participant "Event Collector" as Collector

User -> GW : signed impression/click callback
activate GW
GW -> Collector : verified route + token
activate Collector
Collector -> Collector : validate signature/expiry,\nassign or preserve event_id
Collector -> Spool : enqueue event
Collector --> GW : accepted / redirect
deactivate Collector
GW --> User : 2xx / safe redirect
deactivate GW
Spool -> Kafka : async durable produce
Kafka -> Consumers : duplicate/replay possible
Consumers -> Consumers : idempotent processing

== Отказ фоновых зависимостей ==

note over Bid,Kafka
  Kafka/Redis/PostgreSQL не вызываются синхронно из bid request.
  При недоступности Kafka spool ограничен и поднимает alert.
  При устаревшем сверх порога snapshot readiness=false,
  а новые запросы завершаются no-bid.
end note

@enduml
